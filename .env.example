# =============================================================================
# DYD AI SYLHET — environment template            project: sylhet.dydaiproject.com
# =============================================================================
# Copy to `.env` and fill in. plan.md §17.2 step 6:
#
#     cp .env.example .env && nano .env && chmod 600 .env
#
# `.env` is gitignored and is NEVER auto-created by deploy.sh — a deploy that
# writes configuration is a deploy that can overwrite it.
#
# NO SECRET IN THIS FILE HAS A REAL VALUE. Every blank below must be filled on
# the server, from the password manager (§17.1: host credentials are
# deliberately not recorded in the repository).
#
# `flask check-config` reads this file and fails loudly on the three settings
# that have no safe default: SECRET_KEY, DATABASE_URL's charset, and the
# non-guessable admin prefix.
# -----------------------------------------------------------------------------

# ── Core ──────────────────────────────────────────────────────────────────────
APP_NAME="AI Sylhet"
APP_ENV=production                  # development | testing | production
APP_DEBUG=false
SECRET_KEY=                         # REQUIRED, >= 32 chars:
                                    # python -c "import secrets;print(secrets.token_hex(32))"
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://sylhet.dydaiproject.com
PREFERRED_URL_SCHEME=https
SITE_DEFAULT_LOCALE=bn
SITE_TAGLINE_BN="যুব উন্নয়ন অধিদপ্তর"
MAINTENANCE_MODE=false              # true serves the Bangla "সাময়িকভাবে বন্ধ" page

# ── Database ──────────────────────────────────────────────────────────────────
# dev:  sqlite:///instance/ai_sylhet.db
# prod: MySQL with charset=utf8mb4 — MANDATORY. A latin1 schema mangles every
#       Bangla string silently and is only caught by a human reading the site.
DATABASE_URL=mysql+pymysql://USER:PASS@localhost/DBNAME?charset=utf8mb4
DB_POOL_SIZE=5
DB_POOL_RECYCLE=280                 # under MySQL's wait_timeout; see config.py

# ── Session & admin ───────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=sylhet_ai_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
IDLE_TIMEOUT_SECONDS=1800           # 30 minutes of inactivity
SESSION_LIFETIME_SECONDS=28800      # 8 hours absolute
ADMIN_URL_PREFIX=ops-sylhet         # MUST stay non-guessable; /admin must be a 404
ADMIN_IP_ALLOWLIST=                 # CIDR list, comma-separated; empty = off.
                                    # Recommended once the site is live.
ADMIN_2FA_REQUIRED=true             # TOTP on the single admin account
BCRYPT_LOG_ROUNDS=12
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCKOUT_MINUTES=30
ALLOWED_HOSTS=sylhet.dydaiproject.com,localhost,127.0.0.1

# ── Uploads & storage ─────────────────────────────────────────────────────────
# OUTSIDE the webroot. An upload served from the app directory is an upload that
# can be executed (§13.1).
UPLOAD_ROOT=/home/<user>/sylhet_uploads
MAX_CONTENT_LENGTH_MB=6
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,webp
IMAGE_MAX_DIMENSION=2000
BACKUP_ROOT=var/backups
BACKUP_OFFSITE_CMD=                 # e.g. rclone copy {src} remote:ai-sylhet

# ── Contact form ──────────────────────────────────────────────────────────────
MAIL_PROVIDER=smtp                  # smtp | brevo | dryrun
MAIL_SERVER=mail.<domain>
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=noreply@<domain>
MAIL_PASSWORD=                      # secret — never commit, never store in the DB
MAIL_DEFAULT_SENDER="AI Sylhet <noreply@<domain>>"
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=               # secret
CONTACT_MIN_SECONDS=3               # faster than this is a bot, not a person
CONTACT_MAX_PER_HOUR=3              # per IP

# ── Cache & limits ────────────────────────────────────────────────────────────
CACHE_TYPE=FileSystemCache
CACHE_DIR=var/cache
CACHE_DEFAULT_TIMEOUT=300
STATS_CACHE_TIMEOUT=300             # §15.1: invalidated in the SAME transaction
                                    # as any participant write (§5.3 rule 2)
SITEMAP_CACHE_TIMEOUT=3600
RATELIMIT_STORAGE_URI=memory://     # a single Passenger worker; see DEPLOY.md
RATELIMIT_DEFAULT=200/hour
PARTICIPANTS_PER_PAGE=24
ADMIN_ROWS_PER_PAGE=50
STATS_SUPPRESS_BELOW=5              # §5.4: cells from <5 records render as —

# ── Privacy & retention ───────────────────────────────────────────────────────
RETENTION_MONTHS_MESSAGES=12
RETENTION_MONTHS_AUDIT=36

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=var/logs
LOG_MAX_BYTES=10485760              # 10 MB per file, 5 files (§17.6)
LOG_BACKUP_COUNT=5
ADMIN_ALERT_EMAIL=admin@<domain>
HSTS_MAX_AGE=31536000
